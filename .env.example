# Required for production approval-token signing.
MCPBRIDGE_APPROVAL_SECRET=replace-with-a-long-random-secret
MCPBRIDGE_ENV=development

# Comma-separated host allowlist used by MCP Streamable HTTP DNS-rebinding protection.
MCPBRIDGE_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,*.vercel.app

# Frontend only: points the Next.js server bridge at the deployed REST control plane.
MCPBRIDGE_API_URL=http://127.0.0.1:8000/gateway
